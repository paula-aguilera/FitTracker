<?xml version="1.0" encoding="utf-8"?>
<!-- Vista personalizada de cada ítem del RecyclerView (sin CardView) -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/fondo_item"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Fila superior: tipo a la izquierda, duración a la derecha -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txtTipo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/verde"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="Cardio" />

        <TextView
            android:id="@+id/txtDuracion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="30 min" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtIntensidad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/black"
        android:textSize="15sp"
        tools:text="Intensidad: Alta" />

    <TextView
        android:id="@+id/txtHabitos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/gris_texto"
        android:textSize="14sp"
        tools:text="Calentamiento ✔  Hidratación ✔  Estiramiento ✘" />

    <RatingBar
        android:id="@+id/ratingActividad"
        style="?android:attr/ratingBarStyleSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:isIndicator="true"
        android:numStars="5"
        android:stepSize="1"
        tools:rating="4" />

</LinearLayout>
